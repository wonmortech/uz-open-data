{
  "name": "uz-open-data",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for the uz-open-data explorer demo (the datasets themselves need no build).",
  "license": "MIT",
  "scripts": {
    "demo:build": "node tools/build-demo.mjs",
    "demo": "node tools/build-demo.mjs && node tools/serve-demo.mjs",
