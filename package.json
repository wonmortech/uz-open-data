    "site:screenshots": "node tools/site-screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@playwright/test": "1.65.0"
  }
}
